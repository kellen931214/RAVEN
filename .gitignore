# Python caches and local tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Local virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# Local environment files and secrets
.env
.env.*
!.env.example
*.key
*.pem
*.token

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Agent scratch space. formal evaluation calls require_clean_git_worktree with
# --untracked-files=all, so a stray agent worktree here would otherwise block
# every formal run.
.claude/

# Generated experiment artifacts
outputs/**
!outputs/**/*.md
logs/
out/
raven_repro/outputs/
raven_repro/logs/
*.log
*.pid
*.exit

# External reference repositories checked out locally for audit only
NFPA/
external/

# Local datasets and generated images
data/
datasets/

# Model/cache artifacts
.cache/
cache/
models/
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin

# Package/build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/

# Runtime scratch
tmp/
temp/
*.tmp

# Generated evaluation logs, failure artifacts, and local result tables.
# Keep audit protocol documents and source manifests version-controlled.
audit/ablation_logs/
audit/full_run_logs/
audit/gate_negative/
audit/tables/

# Runtime experiment result records (generated by experiments/update_experiment_table.py)
reports/runtime/
scratch/
